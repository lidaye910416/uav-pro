# UAV-PRO 环境变量配置
# 复制此文件为 .env 并根据实际情况修改
# 注意：端口配置统一由 start.sh + ecosystem.config.js 读取并传递给各服务
# 如需修改默认端口，建议同时修改 start.sh 第 19-25 行的默认值

# ==================== 服务端口配置 ====================
# 后端服务
BACKEND_PORT=8888
BACKEND_HOST=127.0.0.1

# Ollama AI 服务
OLLAMA_PORT=11434

# 前端应用端口（必须与 package.json 中的 ${PORT:-默认值} 一致）
SHOWCASE_PORT=4000
DASHBOARD_PORT=4001
ADMIN_PORT=4002

# ==================== 其他配置 ====================
NODE_ENV=development
