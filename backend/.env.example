# UAV低空检测系统 - 环境变量示例
# 复制为 .env 并修改

# 数据库 (开发用 SQLite)
DATABASE_URL=sqlite+aiosqlite:///./uav.db

# 生产环境推荐 PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://uav_user:your_password@localhost:5432/uav_db

# JWT密钥 (必须修改为强随机密钥)
SECRET_KEY=your-super-secret-key-change-in-production

# ── LLM Provider (默认 minimax, 可选 ollama/anthropic/openai/deepseek/custom) ──
LLM_PROVIDER=minimax
# 外部 Anthropic 兼容中转 (minimax/custom 时使用)
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=
# 本地 Ollama (LLM_PROVIDER=ollama 时使用)
OLLAMA_BASE_URL=http://localhost:11434

# API版本
VERSION=1.0.0
